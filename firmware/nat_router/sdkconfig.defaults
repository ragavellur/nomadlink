# Optimize for performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# WiFi and lwIP IRAM optimization (avoids flash cache misses during packet processing)
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# Reduce bootloader log verbosity
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# assert() aborts without the __FILE__/expression strings
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=1

# esp_err_to_name() returns the numeric code instead of carrying the full
# error-string table
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n

# Increase main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Enable filesystem
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_example.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_example.csv"

# Enable FreeRTOS stats formatting functions, needed for 'tasks' command
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# LWIP
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_IP_FORWARD=y  
CONFIG_LWIP_IPV4_NAPT=y

# PPP over serial - the A7670E 4G uplink. Everything the 4G path needs that the
# Arduino base got for free from the core's default sdkconfig.
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV4=y
# The A7670E is IPv4-only over PPP. Leaving IPv6CP on just stalls Phase Network
# until it times out, and costs a code path we cannot use.
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
# Gated behind PPP_NOTIFY_PHASE in lwip's ppp.h. Without it the state machine
# gives us no way to learn when IPCP assigned an address, which is the only
# honest signal that the 4G link can carry traffic.
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
# Kconfig defaults VJ header compression to y, and its own help text says to
# disable it when NAPT runs on the PPP interface: the compressed IP header can
# be misread in NAT and the packet is dropped with no error anywhere. This build
# NATs all 4G traffic (CONFIG_LWIP_IPV4_NAPT=y above), so it must be off.
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n

# DHCP server
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=16

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Wi-Fi
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=48
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32

# OTA
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
