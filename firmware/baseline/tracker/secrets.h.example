/* Local-only build configuration for tracker.ino.
 *
 * This file is GITIGNORED. Copy secrets.h.example to secrets.h and fill in
 * real values. Never commit secrets.h. Rule 27.
 *
 * Broker credentials were previously hardcoded in tracker.ino and were exposed
 * in plaintext. They have been removed. Because that value was visible outside
 * the repository, treat it as compromised and rotate it at the broker.
 */

#define MQTT_HOST   "broker.hivemq.com"
#define MQTT_PORT   1883
#define MQTT_USER   "your-username"
#define MQTT_PASS   "your-password"
#define MQTT_TOPIC  "nomadlink/one/gps"
#define CLIENT_ID   "nomadlink-one"
