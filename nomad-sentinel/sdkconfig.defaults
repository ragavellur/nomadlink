CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Keep console on UART0 (GPIO43/44 -> CH9102 -> /dev/cu.usbmodem...)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Bring-up diagnostics
CONFIG_LOG_DEFAULT_LEVEL_VERBOSE=y
CONFIG_LOG_DEFAULT_LEVEL=5
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_MAXIMUM_LEVEL=5
# PPP over USB
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_PPP_ENABLE_IPV6=n
# esp_modem throws C++ exceptions on device-open failure; enable so we can
# catch instead of hard abort (boot loop). esp_modem requires this.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# AT+COPS=? returns a long operator list; the default 128-byte buffer truncates
# it mid-entry and hides which access technologies are actually available.
CONFIG_ESP_MODEM_C_API_STR_MAX=512